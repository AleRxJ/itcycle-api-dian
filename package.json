{
  "name": "itcycle-api-dian",
  "version": "0.1.0",
  "private": true,
  "description": "Infraestructura de facturacion electronica DIAN para Ohnix, construida sobre el motor dian-engine (vendored de dian-kit).",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build:engine": "pnpm --filter @dian-kit/core --filter @dian-kit/sdk-node run build",
    "build": "pnpm run build:engine && prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed:test-company": "tsx scripts/seed-test-company.ts"
  },
  "dependencies": {
    "@dian-kit/core": "workspace:*",
    "@dian-kit/sdk-node": "workspace:*",
    "@prisma/client": "^6.2.1",
    "dotenv": "^16.4.5",
    "fastify": "^5.2.0",
    "node-cron": "^4.6.0",
    "node-forge": "^1.4.0",
    "pino": "^9.6.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/node-forge": "^1.3.14",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
