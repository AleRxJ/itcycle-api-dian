// ITCycle data model.
//
// Everything here is ITCycle's own persistence layer (tenants, config,
// certificates, documents) — none of this duplicates dian-kit, which stays
// stateless (it only builds/signs/sends XML). See docs/dian/compatibility.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

/// Mirrors DIAN's TipoAmbiente codes directly ("1" = Produccion, "2" = Habilitacion)
/// so it can be passed straight through to dian-kit without translation.
enum DianEnvironment {
  PRODUCTION
  SANDBOX
}

enum InvoiceStatus {
  PENDING
  PROCESSING
  SENT
  ACCEPTED
  REJECTED
  ERROR
  CONTINGENCY
}

/// A tenant of ITCycle: one company/person that issues electronic documents.
/// Every other table is scoped to a companyId — no record may ever be
/// readable or usable by a different company.
model Company {
  id         String       @id @default(cuid())
  name       String
  nit        String
  dv         String
  personType String // DIAN PersonType code: "1" Juridica, "2" Natural
  status     RecordStatus @default(ACTIVE)
  /// FirmaPass login key (Bearer token for identidad.firmapass.com), AES-256-GCM
  /// encrypted at rest via src/shared/secretEncryption.ts + FIRMAPASS_ENCRYPTION_KEY.
  /// One active login key per company, mirroring FirmaPass's own one-key-per-account
  /// model. Never returned by any API response.
  firmaPassLoginKeyCiphertext String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dianConfiguration    DianConfiguration?
  numberingResolutions NumberingResolution[]
  certificates         Certificate[]
  invoices             Invoice[]
  creditNotes          CreditNote[]
  debitNotes           DebitNote[]
  supportDocuments     SupportDocument[]
  apiKeys              ApiKey[]

  @@unique([nit, dv])
}

/// A production API key bound to exactly one Company. `keyHash` is the only
/// thing persisted (SHA-256 of the raw key — high-entropy random tokens
/// don't need a slow password hash); the raw key itself is shown to the
/// caller of scripts/create-api-key.ts exactly once and never stored.
/// `keyPrefix` (first 8 chars of the raw key) exists only so a key can be
/// identified/logged without ever reconstructing or revealing the rest.
model ApiKey {
  id         String       @id @default(cuid())
  companyId  String
  keyHash    String       @unique
  keyPrefix  String
  label      String
  status     RecordStatus @default(ACTIVE)
  lastUsedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

/// DIAN registration details for a company's software (habilitacion).
/// One-to-one with Company: a tenant has a single active DIAN registration
/// at a time.
model DianConfiguration {
  id              String          @id @default(cuid())
  companyId       String          @unique
  environment     DianEnvironment
  softwareId      String
  softwarePin     String
  technicalKey    String?
  /// Full dian-kit `Party` shape for the supplier (name, identification,
  /// personType, fiscalResponsibilities, taxInfo, address, email). Kept as
  /// JSON rather than normalized columns until ITCycle needs to query into
  /// it — it is passed straight through to DianKitProvider as-is.
  supplierProfile Json?
  status          RecordStatus    @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

/// A DIAN numbering authorization (resolucion de numeracion) assigned to a
/// company. A company may hold multiple resolutions over time (renewals,
/// different prefixes); `currentNumber` tracks the next number to issue.
///
/// DIAN requires a separate authorized numbering range per document type
/// (factura != nota credito != nota debito != documento soporte) —
/// `documentType` (DIAN document type code: "01" factura, "91" nota credito,
/// "92" nota debito, "05" documento soporte) is what `claimNextNumber`
/// filters on so each document type advances its own range.
model NumberingResolution {
  id               String       @id @default(cuid())
  companyId        String
  documentType     String       @default("01")
  prefix           String
  resolutionNumber String
  startNumber      Int
  endNumber        Int
  currentNumber    Int
  startDate        DateTime
  endDate          DateTime
  status           RecordStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoices         Invoice[]
  creditNotes      CreditNote[]
  debitNotes       DebitNote[]
  supportDocuments SupportDocument[]

  @@unique([companyId, prefix])
  @@index([companyId])
  @@index([companyId, documentType, status])
}

/// Metadata about a digital certificate used to sign a company's documents.
/// The private key/secret itself is NEVER stored here — `secretReference`
/// only points into a CertificateSecretStore (Vault/KMS/etc).
model Certificate {
  id                     String       @id @default(cuid())
  companyId              String
  provider               String // e.g. "firmapass"
  certificateIdentifier  String // provider-side reference, not the cert itself
  secretReference        String // pointer into CertificateSecretStore
  /// Null while a FirmaPass certificate is still being issued (status
  /// INACTIVE, real value not known until the provider confirms — see
  /// src/jobs/firmaPassIssuance.job.ts). Always set for non-FirmaPass
  /// providers, and set for FirmaPass once issuance finishes.
  expiresAt              DateTime?
  status                 RecordStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoices         Invoice[]
  creditNotes      CreditNote[]
  debitNotes       DebitNote[]
  supportDocuments SupportDocument[]

  @@index([companyId])
}

/// An electronic invoice (Factura de Venta) issued by a company.
model Invoice {
  id                  String        @id @default(cuid())
  companyId           String
  numberingId         String?
  certificateId        String?
  internalReference   String // idempotency key (e.g. Idempotency-Key header)
  invoiceNumber        String? // full number, e.g. "SETP990000001"
  prefix               String?
  cufe                 String?
  status               InvoiceStatus @default(PENDING)
  /// True when `send` went through SimulatedDianProvider instead of a real
  /// DIAN connection (DIAN_SIMULATION_MODE). ACCEPTED + simulated=true is
  /// NOT a real DIAN acceptance — see docs/dian/simulation.md.
  simulated             Boolean       @default(false)
  xmlReference          String? // pointer to stored signed XML (not inlined here)
  dianResponseReference String? // pointer to stored raw DIAN response
  issuedAt              DateTime?
  sentAt                DateTime?
  acceptedAt            DateTime?
  rejectedAt            DateTime?
  errorCode             String?
  errorMessage          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company     Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  numbering   NumberingResolution? @relation(fields: [numberingId], references: [id])
  certificate Certificate?         @relation(fields: [certificateId], references: [id])
  creditNotes CreditNote[]
  debitNotes  DebitNote[]

  @@unique([companyId, internalReference])
  @@index([companyId, status])
}

/// A credit note (Nota Credito, DIAN type 91) that partially or fully
/// reverses a previously issued, ACCEPTED Invoice. Always references that
/// Invoice — the billingReference/discrepancyResponse.referenceId sent to
/// dian-kit are derived from it, never taken raw from the caller.
model CreditNote {
  id                      String        @id @default(cuid())
  companyId               String
  invoiceId               String
  numberingId             String?
  certificateId           String?
  internalReference       String // idempotency key
  noteNumber              String? // full number, e.g. "NC0000001"
  prefix                  String?
  cufe                    String?
  discrepancyResponseCode String // DIAN correction code, e.g. "2" = anulacion
  discrepancyDescription  String
  status                  InvoiceStatus @default(PENDING)
  /// See Invoice.simulated — same meaning, same caveat (docs/dian/simulation.md).
  simulated               Boolean       @default(false)
  xmlReference            String?
  dianResponseReference   String?
  issuedAt                DateTime?
  sentAt                  DateTime?
  acceptedAt              DateTime?
  rejectedAt              DateTime?
  errorCode               String?
  errorMessage            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company     Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoice     Invoice              @relation(fields: [invoiceId], references: [id])
  numbering   NumberingResolution? @relation(fields: [numberingId], references: [id])
  certificate Certificate?         @relation(fields: [certificateId], references: [id])

  @@unique([companyId, internalReference])
  @@index([companyId, status])
  @@index([invoiceId])
}

/// A debit note (Nota Debito, DIAN type 92) that increases the amount owed
/// on a previously issued, ACCEPTED Invoice. Same shape/rules as CreditNote.
model DebitNote {
  id                      String        @id @default(cuid())
  companyId               String
  invoiceId               String
  numberingId             String?
  certificateId           String?
  internalReference       String
  noteNumber              String?
  prefix                  String?
  cufe                    String?
  discrepancyResponseCode String // DIAN correction code, e.g. "1" = intereses
  discrepancyDescription  String
  status                  InvoiceStatus @default(PENDING)
  simulated               Boolean       @default(false)
  xmlReference            String?
  dianResponseReference   String?
  issuedAt                DateTime?
  sentAt                  DateTime?
  acceptedAt              DateTime?
  rejectedAt              DateTime?
  errorCode               String?
  errorMessage            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company     Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoice     Invoice              @relation(fields: [invoiceId], references: [id])
  numbering   NumberingResolution? @relation(fields: [numberingId], references: [id])
  certificate Certificate?         @relation(fields: [certificateId], references: [id])

  @@unique([companyId, internalReference])
  @@index([companyId, status])
  @@index([invoiceId])
}

/// Postgres-backed CertificateSecretStore row (see
/// src/providers/certificates/PrismaCertificateSecretStore.ts) — an
/// alternative to the filesystem-backed stores for deployments without a
/// persistent disk (e.g. Render's free tier, where local disk is wiped on
/// every restart). `reference` matches Certificate.secretReference.
/// Ciphertext columns are AES-256-GCM encrypted with CERTIFICATE_ENCRYPTION_KEY
/// before they ever reach this table — Postgres never sees plaintext.
model CertificateSecretBlob {
  reference          String @id
  p12Ciphertext      Bytes
  passwordCiphertext Bytes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Postgres-backed DocumentXmlStore row (see
/// src/providers/documents/PrismaDocumentXmlStore.ts) — same motivation as
/// CertificateSecretBlob. `reference` matches Invoice/CreditNote/DebitNote/
/// SupportDocument.xmlReference. Not encrypted: the XML is the legal
/// document itself, not a secret (see DocumentXmlStore.ts).
model DocumentXmlBlob {
  reference String @id
  xml       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A Documento Soporte (DIAN type 05) — a self-issued document for
/// acquisitions from suppliers not obligated to issue an electronic invoice.
/// Unlike CreditNote/DebitNote, this is standalone: it does not reference or
/// correct a prior Invoice.
model SupportDocument {
  id                     String        @id @default(cuid())
  companyId              String
  numberingId            String?
  certificateId          String?
  internalReference      String // idempotency key
  documentNumber         String? // full number, e.g. "DSNO0000001"
  prefix                 String?
  cufe                   String? // CUDE, despite the field name (matches Invoice/CreditNote/DebitNote's own convention)
  status                 InvoiceStatus @default(PENDING)
  simulated              Boolean       @default(false)
  xmlReference           String?
  dianResponseReference  String?
  issuedAt               DateTime?
  sentAt                 DateTime?
  acceptedAt             DateTime?
  rejectedAt             DateTime?
  errorCode              String?
  errorMessage           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company     Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  numbering   NumberingResolution? @relation(fields: [numberingId], references: [id])
  certificate Certificate?         @relation(fields: [certificateId], references: [id])

  @@unique([companyId, internalReference])
  @@index([companyId, status])
}
