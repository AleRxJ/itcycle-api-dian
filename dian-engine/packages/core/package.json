{
  "name": "@dian-kit/core",
  "version": "1.0.1",
  "description": "Core logic for DIAN electronic invoicing: XML/UBL 2.1, digital signatures, CUFE/CUDE generation",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:unit": "vitest run --dir tests/unit",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "check": "biome check src/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "keywords": [
    "dian",
    "ubl",
    "xml",
    "invoice",
    "colombia",
    "factura-electronica"
  ],
  "author": "Sergio Rojas <dian-kit@sergioarojasm98.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sergioarojasm98/dian-kit.git",
    "directory": "packages/core"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.8.11",
    "fflate": "^0.8.2",
    "node-forge": "^1.4.0",
    "xadesjs": "^2.6.6",
    "xml-core": "^1.2.5",
    "xmlbuilder2": "^4.0.3",
    "xmldsigjs": "^2.8.6",
    "xpath": "^0.0.34",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node-forge": "^1.3.14",
    "tsup": "^8.5.1",
    "typescript": "6.0.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
