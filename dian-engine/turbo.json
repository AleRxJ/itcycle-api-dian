{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tsconfig.json", "package.json"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": ["src/**", "tests/**"],
      "outputs": ["coverage/**"]
    },
    "test:unit": {
      "dependsOn": ["build"],
      "inputs": ["src/**", "tests/unit/**"],
      "outputs": ["coverage/**"]
    },
    "test:integration": {
      "dependsOn": ["build"],
      "inputs": ["src/**", "tests/integration/**"],
      "outputs": ["coverage/**"]
    },
    "lint": {
      "inputs": ["src/**", "biome.json"]
    },
    "lint:fix": {
      "inputs": ["src/**", "biome.json"]
    },
    "format": {
      "inputs": ["src/**", "biome.json"]
    },
    "check": {
      "inputs": ["src/**", "biome.json"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tsconfig.json"]
    },
    "clean": {
      "cache": false
    }
  }
}
