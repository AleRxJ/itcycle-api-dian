DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
PORT=3000
NODE_ENV=development
DEV_API_KEY=
# Protects /api/v1/admin/* (tenant provisioning) — only Ohnix's backend should hold this.
ADMIN_API_KEY=
CERTIFICATES_DIR=./certs
DOCUMENTS_DIR=./documents
# "file" (default) uses CERTIFICATES_DIR/DOCUMENTS_DIR on local disk — needs a
# persistent disk in production. "database" persists certificates/XML as rows
# in Postgres instead (PrismaCertificateSecretStore/PrismaDocumentXmlStore) —
# no extra infra needed, useful on hosts without a persistent disk (e.g.
# Render's free tier).
STORAGE_DRIVER=file
# 32 raw bytes, base64url-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Unset falls back to plaintext storage when STORAGE_DRIVER=file — fine for
# local dev, never for production. Required when STORAGE_DRIVER=database.
CERTIFICATE_ENCRYPTION_KEY=
# See docs/dian/simulation.md — dev/demo only, never a real DIAN acceptance.
DIAN_SIMULATION_MODE=false
# Master on/off switch for the contingency-retry cron job. Set to false for tests/one-off scripts.
START_SCHEDULER=true
# How often CONTINGENCY documents are automatically retried against DIAN.
CONTINGENCY_RETRY_CRON=*/10 * * * *
# 32 raw bytes, base64url-encoded — same generation command as above.
# Historically encrypted Company.firmaPassLoginKeyCiphertext at rest; that
# column is no longer written (see FIRMAPASS_ALLIANCE_LOGIN_KEY below) but is
# kept in the schema. Never share this key with CERTIFICATE_ENCRYPTION_KEY.
FIRMAPASS_ENCRYPTION_KEY=
# How often pending FirmaPass certificate issuances are polled.
FIRMAPASS_ISSUANCE_CRON=*/10 * * * *
# iTCycle's OWN FirmaPass "alianza" login key (from FirmaPass's portal) — ONE
# account shared by every provisioned company, not a per-company credential.
# A client's certificate purchase (made on FirmaPass's own site with
# iTCycle's coupon) auto-attaches to this alliance account.
FIRMAPASS_ALLIANCE_LOGIN_KEY=
